# Copy the values you need into scripts/stateless-scenario/.env; it is ignored by git.
AWS_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://YOUR_S3_ENDPOINT
AWS_S3_BUCKET=YOUR_EXISTING_S3_BUCKET
# Optional; defaults to us-east-1. Override for endpoints requiring another region.
# AWS_DEFAULT_REGION=us-east-1
# May also be exported in the calling environment.
HOMER_SCENARIO_POSTGRES_DSN="postgres://test_role:password@pg-host/postgres?sslmode=require"
