{
  "ingest": {
    "enable": true,
    "worker_count": 8,
    "queue_size": 80000,
    "udp": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9060,
      "multicore": true
    },
    "tcp": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9060,
      "multicore": true
    },
    "tls": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 9061,
      "cert": "/etc/homer/certs/server.crt",
      "key": "/etc/homer/certs/server.key",
      "min_tls_version": "TLS1.2"
    },
    "http": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9080,
      "read_timeout": 30,
      "write_timeout": 30,
      "max_request_body_size": 67108864,
      "websocket_enable": false
    },
    "https": {
      "enable": false
    },
    "hep": {
      "hepv2_enable": true,
      "hepv3_enable": true,
      "protobuf_enable": true,
      "deduplicate": false
    },
    "sip": {
      "censored_methods": [],
      "discard_methods": [],
      "aleg_ids": ["X-CID", "X-Session-ID"],
      "custom_headers": [],
      "force_aleg_id": false
    }
  },
  "storage": {
    "enable": true,
    "ducklake": {
      "catalog_type": "sqlite",
      "catalog_path": "/data/homer/homer_catalog.sqlite",
      "data_path": "/data/homer/parquet",
      "lake_name": "homer_lake",
      "batch_size": 10000,
      "flush_interval_sec": 30,
      "tuning": {
        "threads": 2,
        "memory_limit": "2GB"
      },
      "s3": {
        "region": "",
        "access_key_id": "",
        "secret_access_key": "",
        "endpoint": "",
        "use_ssl": true
      },
      "compaction": {
        "enable": true,
        "check_interval_sec": 1800,
        "retention_days": 30,
        "snapshot_expire_interval_sec": 3600,
        "min_age_sec": 3600,
        "min_file_size_bytes": 0,
        "max_file_size_bytes": 134217728,
        "max_compacted_files": 100
      },
      "storage_policy": {
        "enable": false,
        "ttl_move_interval_sec": 3600,
        "move_factor": 0.8,
        "concurrent_moves": 2,
        "move_on_startup": false,
        "volumes": [
          {
            "name": "hot",
            "type": "local",
            "path": "/data/homer/parquet",
            "priority": 0,
            "max_data_age_days": 7,
            "max_size_gb": 100
          },
          {
            "name": "cold",
            "type": "s3",
            "path": "s3://your-bucket/homer/cold/",
            "priority": 1,
            "max_data_age_days": 0,
            "s3_region": "us-east-1",
            "s3_access_key_id": "",
            "s3_secret_access_key": "",
            "s3_endpoint": "",
            "s3_use_ssl": true
          }
        ]
      }
    }
  },
  "node": {
    "enable": true,
    "flight_server": {
      "host": "0.0.0.0",
      "port": 50051,
      "auth_token": "your-secret-token-here",
      "max_message_size": 16777216
    },
    "flightsql_server": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 50055,
      "auth_token": "",
      "catalog_refresh_interval_sec": 30
    },
    "ducklake": {
      "lake_name": "homer_lake",
      "volumes": [
        {
          "name": "default",
          "type": "local",
          "catalog_type": "sqlite",
          "catalog_path": "/data/homer/homer_catalog.sqlite",
          "path": "/data/homer/parquet"
        }
      ]
    }
  },
  "coordinator": {
    "enable": false
  },
  "log": {
    "level": "info",
    "json": false,
    "output": ["stdout"],
    "file": {
      "path": "/var/log/homer",
      "name": "homer.log",
      "max_age_days": 7,
      "rotation_hours": 24,
      "max_size_mb": 100
    },
    "stdout": {
      "colored": true
    },
    "syslog": {
      "uri": "",
      "facility": "local0",
      "level": "LOG_INFO",
      "tag": "homer"
    }
  },
  "prometheus": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 9090,
    "path": "/metrics",
    "agent_label": "node_id"
  },
  "remote_logging": {
    "loki": {
      "enable": false,
      "url": "http://localhost:3100/loki/api/v1/push",
      "loki_custom_labels": []
    }
  }
}
