{
  "ingest": {
    "enable": true,
    "udp": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9060,
      "multicore": true
    },
    "tcp": {
      "enable": false
    },
    "tls": {
      "enable": false
    },
    "http": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9080,
      "websocket_enable": false
    },
    "https": {
      "enable": false
    },
    "hep": {
      "hepv2_enable": true,
      "hepv3_enable": true,
      "protobuf_enable": true,
      "deduplicate": false
    }
  },
  "storage": {
    "enable": true,
    "ducklake": {
      "catalog_type": "sqlite",
      "catalog_path": "/data/homer/homer_catalog.sqlite",
      "data_path": "/data/homer/parquet",
      "lake_name": "homer_lake",
      "batch_size": 10000,
      "flush_interval_sec": 30,
      "tuning": {
        "threads": 2,
        "memory_limit": "2GB"
      }
    }
  },
  "node": {
    "enable": true,
    "flight_server": {
      "host": "0.0.0.0",
      "port": 50051,
      "auth_token": "your-secret-token-here",
      "max_message_size": 16777216
    },
    "flightsql_server": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 50055,
      "auth_token": "",
      "catalog_refresh_interval_sec": 30
    },
    "ducklake": {
      "catalog_type": "sqlite",
      "catalog_path": "/data/homer/homer_catalog.sqlite",
      "data_path": "/data/homer/parquet",
      "lake_name": "homer_lake"
    }
  },
  "coordinator": {
    "enable": false
  },
  "log": {
    "level": "info",
    "json": false,
    "output": ["stdout"],
    "file": {
      "path": "/var/log/homer",
      "name": "homer.log",
      "max_age_days": 7,
      "rotation_hours": 24,
      "max_size_mb": 100
    },
    "stdout": {
      "colored": true
    },
    "syslog": {
      "uri": "",
      "facility": "local0",
      "level": "LOG_INFO",
      "tag": "homer"
    }
  },
  "prometheus": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 9090,
    "path": "/metrics",
    "agent_label": "node_id"
  }
}
