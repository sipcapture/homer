{
  "ingest": {
    "enable": true,
    "udp": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9060,
      "multicore": true
    },
    "tcp": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9060,
      "multicore": true
    },
    "tls": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 9061,
      "cert": "/etc/homer/certs/server.crt",
      "key": "/etc/homer/certs/server.key",
      "min_tls_version": "TLS1.2"
    },
    "http": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 9080,
      "read_timeout": 30,
      "write_timeout": 30,
      "max_request_body_size": 67108864,
      "websocket_enable": false
    },
    "https": {
      "enable": false
    },
    "hep": {
      "hepv2_enable": true,
      "hepv3_enable": true,
      "protobuf_enable": true,
      "deduplicate": false
    },
    "sip": {
      "censored_methods": [],
      "discard_methods": [],
      "aleg_ids": ["X-CID", "X-Session-ID"],
      "custom_headers": [],
      "force_aleg_id": false
    }
  },
  "storage": {
    "enable": true,
    "ducklake": {
      "catalog_type": "sqlite",
      "catalog_path": "/data/homer/homer_catalog.sqlite",
      "data_path": "/data/homer/parquet",
      "lake_name": "homer_lake",
      "batch_size": 25000,
      "flush_interval_sec": 30,
      "search_buffer": true,
      "tuning": {
        "threads": 2,
        "memory_limit": "2GB"
      },
      "compaction": {
        "enable": true,
        "check_interval_sec": 1800,
        "retention_days": 30,
        "snapshot_expire_interval_sec": 3600,
        "min_age_sec": 3600,
        "min_file_size_bytes": 0,
        "max_file_size_bytes": 134217728,
        "max_compacted_files": 100
      }
    }
  },
  "node": {
    "enable": true,
    "flight_server": {
      "host": "0.0.0.0",
      "port": 50051,
      "auth_token": "your-secret-token-here",
      "max_message_size": 16777216
    },
    "flightsql_server": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 50055,
      "auth_token": "",
      "catalog_refresh_interval_sec": 30
    },
    "ducklake": {
      "lake_name": "homer_lake",
      "volumes": [
        {
          "name": "default",
          "type": "local",
          "catalog_type": "sqlite",
          "catalog_path": "/data/homer/homer_catalog.sqlite",
          "path": "/data/homer/parquet"
        }
      ]
    }
  },
  "coordinator": {
    "enable": true,
    "http_server": {
      "enable": true,
      "host": "0.0.0.0",
      "port": 8080,
      "read_timeout": 30,
      "write_timeout": 30,
      "static_path": "/usr/local/homer-core/dist"
    },
    "nodes": [
      {
        "name": "local",
        "host": "127.0.0.1",
        "port": 50051,
        "flightsql_port": 0,
        "use_tls": false,
        "token": "your-secret-token-here",
        "priority": 1
      }
    ],
    "flightsql_server": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 32010,
      "auth_token": "",
      "catalog_refresh_interval_sec": 30
    },
    "settings_db_path": "/var/lib/homer/homer_settings.duckdb",
    "jwt": {
      "secret": "change-this-to-a-secure-random-string-in-production",
      "expire_hours": 24
    },
    "auth": { "type": "internal" }
  },
  "log": {
    "level": "info",
    "json": false,
    "output": ["stdout"],
    "file": {
      "path": "/var/log/homer",
      "name": "homer.log",
      "max_age_days": 7,
      "rotation_hours": 24,
      "max_size_mb": 100
    },
    "stdout": {
      "colored": true
    },
    "syslog": {
      "uri": "",
      "facility": "local0",
      "level": "LOG_INFO",
      "tag": "homer"
    }
  },
  "prometheus": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 9090,
    "path": "/metrics"
  }
}