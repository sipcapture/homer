# Copy to .env and adjust. RustFS credentials must match config/homer.json
# (storage_policy + node.ducklake cold volume). See ../../docs/STORAGE_POLICIES.md.

HOMER_IMAGE=ghcr.io/sipcapture/homer:latest

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Host port mappings (RustFS S3 API and web console)
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local testing only — see rustfs/rustfs docker-compose-simple.yml
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false
